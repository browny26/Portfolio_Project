# Contact form (Resend). Copy to .env.local and fill in.

# API key from https://resend.com/api-keys ("Sending access" is enough).
RESEND_API_KEY=

# Where messages from the contact form are delivered.
# While the sender is onboarding@resend.dev, Resend only delivers to the
# email address of the Resend account itself.
CONTACT_TO_EMAIL=

# Sender. Leave unset to use Resend's test sender; once a domain is verified
# on Resend, use an address on it, e.g. "Portfolio <contatti@tuodominio.it>".
# CONTACT_FROM_EMAIL=

# SEO. Canonical origin; production deploys already default to
# https://luisacerinogbeiwi.dev, so set this only to override it.
# NEXT_PUBLIC_SITE_URL=
# Google Search Console HTML-tag verification code (only the content="…" value).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
